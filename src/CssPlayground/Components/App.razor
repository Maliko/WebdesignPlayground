<!DOCTYPE html>
<html lang="de">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="stylesheet" href="app.css" />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🎨</text></svg>" />
    <HeadOutlet @rendermode="RenderModeServer" />
</head>

<body>
    <Routes @rendermode="RenderModeServer" />
    <script src="_framework/blazor.web.js"></script>
</body>

</html>

@code {
    // Ohne Prerendering steht JavaScript-Interop (Editor, localStorage) sofort zur Verfügung.
    private static readonly IComponentRenderMode RenderModeServer = new InteractiveServerRenderMode(prerender: false);
}
